    },
    "format": {
      "mode": "unresolved",
      "command": "",
      "args": [],
      "instructions": "Determine the project's formatting or format-check command.",
      "evidenceRequired": false
    },
    "lint": {
      "mode": "unresolved",
      "command": "",
      "args": [],
      "instructions": "Determine the project's static analysis command.",
      "evidenceRequired": false
    },
    "typecheck": {
      "mode": "unresolved",
      "command": "",
      "args": [],
      "instructions": "Determine the type-check command or explicitly mark this operation forbidden or manual.",
      "evidenceRequired": false
