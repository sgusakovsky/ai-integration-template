{
  "name": "project-ai-workspace",
  "version": "3.1.1",
  "private": true,
  "description": "Project-specific AI workspace kept separate from the project repository",
  "type": "module",
  "bin": {
    "aiw": "bin/aiw-global.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node bin/aiw.mjs doctor",
    "verify": "node bin/aiw.mjs verify",
    "test": "node --test tests/*.test.mjs",
    "self-test": "node bin/aiw.mjs self-test",
    "self-scan": "node bin/aiw.mjs self-scan",
    "package": "node scripts/package.mjs",
    "docker-smoke": "node scripts/docker-smoke.mjs",
    "register": "node bin/aiw-global.mjs register ."
  }
}
